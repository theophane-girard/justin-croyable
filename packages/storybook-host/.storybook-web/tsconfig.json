{
  "//": "Confort éditeur pour la config Storybook web. Hors du build/typecheck Nx.",
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "noUnusedLocals": false
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
