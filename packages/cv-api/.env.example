NODE_ENV=development
PORT=3100

# Postgres (Supabase / Neon) — connection string en mode "session pooler" recommandé
DATABASE_URL=postgres://user:password@host:5432/postgres

# Origine(s) autorisée(s) pour CORS (séparées par des virgules).
# Défaut : port Angular du site CV (4200) et de l'app d'admin (4400).
CORS_ORIGIN=http://localhost:4200,http://localhost:4400

# Optionnel : origines supplémentaires par expression régulière
# (ex. canaux de prévisualisation Firebase Hosting).
# CORS_ORIGIN_REGEX=^https://mon-cv--preview-.*\.web\.app$

# Seul compte Google autorisé à modifier le CV. Toute écriture faite avec un
# autre compte authentifié reçoit un 403. En CI/prod, valeur fournie par le
# secret GitHub du même nom.
RESUME_ADMIN_EMAIL=moi@example.com

# Compte de service Firebase (Console Firebase → Paramètres → Comptes de service)
# Sert à vérifier les ID tokens Google émis côté navigateur.
FIREBASE_PROJECT_ID=mon-projet
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@mon-projet.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
