{
  "//": "Typecheck Nx des stories, de la config Storybook et du harnais Vitest. La compilation réelle (AOT Angular) passe par .storybook/tsconfig.json.",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["node"],
    "experimentalDecorators": true,
    "noUnusedLocals": false,
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo"
  },
  "include": ["src/**/*.ts", ".storybook/main.ts", "vitest.config.ts"],
  "exclude": ["dist", "out-tsc", "src/**/*.spec.ts"],
  "references": [
    {
      "path": "../../libs/design-system/tsconfig.lib.json"
    }
  ]
}
