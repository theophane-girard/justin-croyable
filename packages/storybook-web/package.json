    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@jsverse/transloco": "^8.4.0",
    "@justin-croyable/design-system": "*",
    "@ng-icons/core": "^33.2.3",
    "@ng-icons/lucide": "^33.2.3",
    "ag-grid-angular": "^36.0.2",
    "ag-grid-community": "^36.0.2",
    "echarts": "^6.1.0",
    "ngx-echarts": "^21.0.0",
    "ngx-sonner": "^3.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
