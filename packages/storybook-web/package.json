    "@storybook/angular": "^10.5.5",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.15",
    "postcss-loader": "^8.2.1",
    "storybook": "^10.5.5",
    "storybook-version": "^0.1.9",
    "tailwindcss": "^4.3.3",
