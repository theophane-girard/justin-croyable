{
  "name": "@justin-croyable/design-system",
  "version": "0.0.1",
  "description": "Design System web (Angular) — composants zard + preset Tailwind du DS",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./components/*": {
      "types": "./src/components/*/index.ts",
      "default": "./src/components/*/index.ts"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "default": "./src/utils/index.ts"
    },
    "./theme.css": "./src/theme/theme.css",
    "./primitives.css": "./src/theme/primitives.css",
    "./tailwind.preset": "./tailwind.preset.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@jsverse/transloco": "^8.4.0",
    "@ng-icons/core": "^33.0.0",
    "@ng-icons/lucide": "^33.0.0",
    "@ng-icons/phosphor-icons": "^33.0.0",
    "ag-grid-angular": "^36.0.0",
    "ag-grid-community": "^36.0.0",
    "echarts": "^6.0.0",
    "ngx-echarts": "^21.0.0",
    "ngx-sonner": "^3.1.0",
    "rxjs": "^7.8.0"
  },
  "//": "Tailwind n'est PAS déclaré en peerDependency à dessein : aucun fichier TS de la lib ne l'importe, c'est une dépendance de build du CSS de l'app. Le déclarer casserait l'installation du monorepo, où le track NativeWind hoiste tailwindcss@3 pendant que le DS web tourne sur v4. Le consommateur doit fournir : tailwindcss >= 4 et tailwindcss-animate >= 1 (cf. src/theme/styles.css)."
}
